{
  "name": "tresridge",
  "version": "1.0.0",
  "description": "The .tres relation standard: one edge grammar, one resolution contract, many hosts.",
  "type": "module",
  "types": "./src/lint.d.mts",
  "exports": {
    ".": {
      "types": "./src/lint.d.mts",
      "default": "./src/lint.mjs"
    },
    "./graph": {
      "types": "./src/graph.d.mts",
      "default": "./src/graph.mjs"
    },
    "./rules": {
      "types": "./src/rules.d.mts",
      "default": "./src/rules.mjs"
    },
    "./tres": {
      "types": "./src/tres.d.mts",
      "default": "./src/tres.mjs"
    },
    "./spec/*": "./spec/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tresridge": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "spec",
    "packs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/battery.mjs",
    "test:cli": "node test/cli.mjs",
    "test:drift": "node test/drift.mjs",
    "test:types": "node test/types.mjs",
    "test:ship": "node --test test/ship-from-download.test.cjs",
    "test:packs": "node test/packs.mjs",
    "matrix:gen": "node scripts/gen-refusal-matrix.mjs",
    "matrix:check": "node scripts/gen-refusal-matrix.mjs --check",
    "vocab:check": "node scripts/check-vocabulary.mjs",
    "vocab:write": "node scripts/check-vocabulary.mjs --write",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:write": "node scripts/check-docs.mjs --write",
    "check:tool": "npm test && npm run test:types && npm run test:packs && npm run matrix:check && npm run vocab:check && npm run docs:check && npm run test:ship",
    "check": "npm run check:tool && npm run site:check",
    "prepublishOnly": "npm run check",
    "ship": "node scripts/ship-from-download.cjs",
    "release:verify": "coreforge verify-release --allow packs/",
    "site:check": "coreforge check",
    "site:doctor": "coreforge doctor",
    "site:sync": "coreforge sync",
    "site:sync:check": "coreforge sync --check",
    "site:build": "npm run build --prefix web",
    "site:docs": "cd docs && bundle exec jekyll build",
    "site:dev": "npm run dev --prefix web",
    "packs": "node scripts/run-packs.mjs",
    "lint:packs": "node bin/cli.mjs lint-packs --deep",
    "conform:packs": "packstruct audit-conformance . --loader \"node scripts/run-packs.mjs {packs}\"",
    "og": "node web/scripts/og-image.mjs --mark-art web/public/og-image-alt.jpg --mark-crop 592,551,900,900"
  },
  "keywords": [
    "tres",
    "godot",
    "graph",
    "relations",
    "spec",
    "lint",
    "dangling-reference"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaupin/tresridge.git"
  },
  "devDependencies": {
    "coreforge": "^1.0.0",
    "packstruct": "1.1.2"
  },
  "bugs": {
    "url": "https://github.com/dhaupin/tresridge/issues"
  },
  "homepage": "https://tresridge.creadev.org"
}
